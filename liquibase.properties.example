# Copy to liquibase.properties (never commit it). Read by the Liquibase Maven plugin.
# Same SQL Server as rtm-iam-db (its docker-compose.yml starts it); same sa password as its .env.
url=jdbc:sqlserver://localhost:1433;databaseName=rentamovil;encrypt=true;trustServerCertificate=true
username=sa
password=ChangeMe_Local123!

# Password for the fleet_app database user created in 03_dcl (the one rtm-fleet-maintenance connects with).
# Must satisfy SQL Server's password policy; use a different value per environment.
parameter.fleetAppPassword=ChangeMe_FleetApp123!
